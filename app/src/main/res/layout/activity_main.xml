<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F172A">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_silent_mode_off"
        android:tint="#38BDF8"
        android:layout_marginBottom="16dp"
        android:contentDescription="Volume Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengganti Tombol Volume"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khusus Android 7+ (Oppo A71)"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Nonaktif"
        android:textColor="#FCD34D"
        android:textSize="15sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Aktifkan Tombol Volume Melayang"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#0284C7"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Petunjuk:\n1. Tekan tombol aktifkan di atas dan izinkan 'Tampilkan di atas aplikasi lain'.\n2. Bubble mengambang akan muncul di layar Anda.\n3. Anda bisa menggeser posisinya ke mana saja.\n4. Cukup TEKAN SEKALI pada bubble untuk langsung memunculkan pengatur volume di layar!"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
