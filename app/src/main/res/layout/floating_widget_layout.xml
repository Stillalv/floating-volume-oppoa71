<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="6dp">

    <!-- Tombol Lingkaran Utama (Bubble Master) -->
    <FrameLayout
        android:id="@+id/bubble_wrapper"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble_glass"
        android:elevation="12dp">

        <ImageView
            android:id="@+id/icon_main_bubble"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lucide_volume_2"
            android:tint="#FFFFFF"
            android:contentDescription="Volume Bubble" />
    </FrameLayout>

    <!-- Menu Melayang yang Muncul saat Bubble Ditekan -->
    <LinearLayout
        android:id="@+id/layout_expanded_menu"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_expanded_bar"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="14dp">

        <!-- Tombol Volume Turun (-) -->
        <FrameLayout
            android:id="@+id/btn_volume_down"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_action">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_minus"
                android:tint="#F8FAFC"
                android:contentDescription="Volume Down" />
        </FrameLayout>

        <!-- Teks Persentase Volume (cth: 70%) -->
        <TextView
            android:id="@+id/tv_volume_level"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="70%"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Tombol Volume Naik (+) -->
        <FrameLayout
            android:id="@+id/btn_volume_up"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_action">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_plus"
                android:tint="#F8FAFC"
                android:contentDescription="Volume Up" />
        </FrameLayout>

        <!-- Tombol Mute / Unmute -->
        <FrameLayout
            android:id="@+id/btn_mute_toggle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_action">
            <ImageView
                android:id="@+id/icon_mute"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_volume_x"
                android:tint="#EF4444"
                android:contentDescription="Mute / Unmute" />
        </FrameLayout>

        <!-- Tombol Slider Bawaan OS -->
        <FrameLayout
            android:id="@+id/btn_show_slider"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_action">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_sliders"
                android:tint="#38BDF8"
                android:contentDescription="Show Full Slider" />
        </FrameLayout>

        <!-- Tombol Tutup Menu (X) -->
        <FrameLayout
            android:id="@+id/btn_close_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_action">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_x"
                android:tint="#94A3B8"
                android:contentDescription="Close Menu" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
